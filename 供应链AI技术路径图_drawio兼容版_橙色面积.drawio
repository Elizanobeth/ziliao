          <mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/>
        </mxCell>

        <mxCell id="eyebrow" value="MANUFACTURING SUPPLY CHAIN AI ROADMAP" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;fontColor=#A65A00;fontFamily=Arial;" vertex="1" parent="1">
