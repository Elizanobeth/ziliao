  <diagram id="supply-chain-ai-roadmap-compatible-orange-area" name="供应链AI发展路径兼容版-橙色面积">
    <mxGraphModel dx="1920" dy="1080" grid="1" gridSize="10" guides="1" tooltips="1" connect="0" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" math="0" shadow="0">
