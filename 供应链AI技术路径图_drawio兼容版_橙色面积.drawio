        </mxCell>
        <mxCell id="title" value="制造业供应链 AI 赋能发展路径" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontColor=#172B4D;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="90" y="95" width="820" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="rule" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#2E94B9;strokeWidth=3;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="165" as="sourcePoint"/>
            <mxPoint x="1780" y="165" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="subtitle" value="以业务场景牵引 AI 建设：边做场景、边补数据、边嵌流程，逐步从“看见问题”走向“推荐方案”和“闭环运营”。" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=20;fontColor=#344563;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="90" y="185" width="1420" height="38" as="geometry"/>
        </mxCell>

        <mxCell id="main-card" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#E1E7EF;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="1740" height="690" as="geometry"/>
        </mxCell>

        <!-- Large orange trend area: one triangle + three trapezoids, top edges aligned to the path -->
        <mxCell id="orange-area-polygons" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;strokeColor=none;fillColor=none;image=data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%27%20width%3D%271600%27%20height%3D%27620%27%20viewBox%3D%270%200%201600%20620%27%3E%3Cpolygon%20points%3D%27115%2C565%20460%2C405%20460%2C565%27%20fill%3D%27%23F4C27A%27%20fill-opacity%3D%270.72%27%2F%3E%3Cpolygon%20points%3D%27460%2C405%20845%2C280%20845%2C565%20460%2C565%27%20fill%3D%27%23F4C27A%27%20fill-opacity%3D%270.72%27%2F%3E%3Cpolygon%20points%3D%27845%2C280%201245%2C145%201245%2C565%20845%2C565%27%20fill%3D%27%23F4C27A%27%20fill-opacity%3D%270.72%27%2F%3E%3Cpolygon%20points%3D%271245%2C145%201500%2C25%201500%2C565%201245%2C565%27%20fill%3D%27%23F4C27A%27%20fill-opacity%3D%270.72%27%2F%3E%3C%2Fsvg%3E;" vertex="1" parent="1">
          <mxGeometry x="190" y="260" width="1600" height="620" as="geometry"/>
        </mxCell>

        <!-- Phase cards -->
        <mxCell id="card1" value="&lt;b&gt;1. 场景牵引启动&lt;/b&gt;&lt;br&gt;&lt;br&gt;不等待全量数据治理完成，先选择需求预测、库存预警、交付风险等高价值场景。&lt;br&gt;&lt;br&gt;产出：试点范围、价值口径、业务负责人。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8C7D9;fontSize=16;fontColor=#344563;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="160" y="355" width="295" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="card2" value="&lt;b&gt;2. 定向数据治理&lt;/b&gt;&lt;br&gt;&lt;br&gt;围绕试点场景补齐必要数据，打通 ERP / MES / WMS / APS 等关键系统。&lt;br&gt;&lt;br&gt;产出：最小可用数据集、指标口径、权限边界。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8C7D9;fontSize=16;fontColor=#344563;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="505" y="315" width="315" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="card3" value="&lt;b&gt;3. 模型预测与推荐&lt;/b&gt;&lt;br&gt;&lt;br&gt;从“发现风险”升级为“给出建议”，支持供需匹配、WIP 周期预测、产能瓶颈、MRO 备件优化。&lt;br&gt;&lt;br&gt;产出：风险排序、推荐方案、影响评估。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8C7D9;fontSize=16;fontColor=#344563;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="875" y="285" width="335" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="card4" value="&lt;b&gt;4. 流程嵌入与协同&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI 建议进入真实业务动作，包括计划评审、采购催交、库存调拨、异常处理和跨部门协同。&lt;br&gt;&lt;br&gt;产出：人审执行、流程留痕、系统回写。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8C7D9;fontSize=16;fontColor=#344563;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1270" y="300" width="335" height="200" as="geometry"/>
        </mxCell>
        <mxCell id="card5" value="&lt;b&gt;5. 控制塔闭环&lt;/b&gt;&lt;br&gt;&lt;br&gt;统一监控订单、库存、产能、供应商和交付风险。AI 推荐，人类审批，系统执行。&lt;br&gt;&lt;br&gt;产出：结果回流、模型迭代、持续优化。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#B8C7D9;fontSize=16;fontColor=#344563;fontFamily=Arial;align=left;verticalAlign=middle;spacingLeft=18;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="1570" y="415" width="230" height="210" as="geometry"/>
        </mxCell>

