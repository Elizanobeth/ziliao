        <mxCell id="dot5" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#F97316;strokeColor=#FFFFFF;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1874" y="214" width="32" height="32" as="geometry"/></mxCell>

        <mxCell id="label1" value="场景启动" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#D8DEE8;fontSize=20;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="320" y="810" width="150" height="42" as="geometry"/></mxCell>
        <mxCell id="label2" value="定向治理" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#D8DEE8;fontSize=20;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="705" y="665" width="174" height="42" as="geometry"/></mxCell>
        <mxCell id="label3" value="预测与推荐" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#D8DEE8;fontSize=20;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1090" y="525" width="196" height="42" as="geometry"/></mxCell>
        <mxCell id="label4" value="流程嵌入" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#D8DEE8;fontSize=20;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1490" y="355" width="196" height="42" as="geometry"/></mxCell>
        <mxCell id="label5" value="控制塔闭环" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#FFFFFF;strokeColor=#D8DEE8;fontSize=20;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1790" y="255" width="200" height="42" as="geometry"/></mxCell>

        <mxCell id="phase1" value="&lt;b&gt;阶段一&lt;/b&gt;&amp;nbsp;&amp;nbsp;0-12个月&lt;br&gt;场景试点 + 定向数据治理" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#253858;strokeColor=none;fontSize=17;fontColor=#FFFFFF;align=left;spacingLeft=45;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="915" width="500" height="82" as="geometry"/></mxCell>
        <mxCell id="phase2" value="&lt;b&gt;阶段二&lt;/b&gt;&amp;nbsp;&amp;nbsp;12-24个月&lt;br&gt;模型推荐 + 流程嵌入" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#84BD00;strokeColor=none;fontSize=17;fontColor=#FFFFFF;align=left;spacingLeft=45;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="740" y="915" width="570" height="82" as="geometry"/></mxCell>
        <mxCell id="phase3" value="&lt;b&gt;阶段三&lt;/b&gt;&amp;nbsp;&amp;nbsp;24-36个月&lt;br&gt;Agent 协同 + AI 控制塔闭环" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F97316;strokeColor=none;fontSize=17;fontColor=#FFFFFF;align=left;spacingLeft=45;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1310" y="915" width="720" height="82" as="geometry"/></mxCell>
        <mxCell id="footer" value="共同机制：业务场景提出数据需求 → 定向治理 → 模型验证 → 流程嵌入 → 结果回流形成数据资产" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#172B4D;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="300" y="1080" width="1600" height="52" as="geometry"/></mxCell>
